Options -Indexes
DirectoryIndex index.php

# Block direct access to sensitive file types
<FilesMatch "\.(json|sql|log|tmp|bak|sh|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block internal directories
    RewriteRule ^(config|helpers|views|data|\.git)(/|$) - [F,L]

    # Static assets live in public/assets but are served at /assets/...
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Page files must never be opened directly - send everything to the router
    RewriteRule ^public/(?!assets/) index.php [R=302,L]
</IfModule>

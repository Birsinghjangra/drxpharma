Options -Indexes
DirectoryIndex index.php

# Block direct access to sensitive files
<FilesMatch "\.(json|sql|log|tmp|bak|sh|md)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(Dockerfile|\.attr_marker|\.alert_sent_.*)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block internal directories, git, and direct hits on page files
    # (pages are only meant to be loaded through index.php?p=...)
    RewriteRule ^(config|helpers|views|data|\.git)(/|$) - [F,L]
    RewriteRule ^public/.*\.php$ - [F,L]
</IfModule>
